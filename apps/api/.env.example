# En producción (Neon, región Frankfurt): DATABASE_URL = la conexión con pooler ("-pooler" en el host),
# DIRECT_URL = la conexión directa, solo para las migraciones.
DATABASE_URL=postgresql://helpjuy:helpjuy@localhost:5433/helpjuy_dev
DIRECT_URL=
DB_POOL_MAX=5
DATABASE_URL_TEST=postgresql://helpjuy:helpjuy@localhost:5433/helpjuy_test
WEB_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=HelpJuy <no-reply@helpjuy.app>
NODE_ENV=development
PORT=4000
# El mismo valor en la web. En producción la API solo atiende pedidos firmados con este secreto
# (menos /health y /internal/maintenance). REQUIRE_PROXY_SECRET=true|false fuerza prenderlo o apagarlo.
PROXY_SECRET=cambiar-por-un-secreto-largo
# Clave de 32 bytes en base64 para cifrar la ficha médica. Generar: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
MEDICAL_DATA_KEY=
# Secreto compartido con la web para revalidar la ficha pública (el mismo valor en apps/web)
REVALIDATE_SECRET=
# Ingreso con Google (opcional). Crear en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Para disparar la limpieza diaria desde un cron externo: POST /internal/maintenance con el header x-maintenance-secret
MAINTENANCE_SECRET=
# Intentos por minuto por IP en ingreso/registro/recuperación (10 por defecto; no bajarlo: en celulares muchos comparten IP)
AUTH_RATE_LIMIT=
# Emails que pueden ver /panel/metricas, separados por coma
ADMIN_EMAILS=
# Emails gratis por Gmail a través de la web: el mismo valor que MAIL_RELAY_SECRET en apps/web (si hay RESEND_API_KEY, se usa Resend)
MAIL_RELAY_SECRET=
