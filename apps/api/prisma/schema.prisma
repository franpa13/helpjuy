generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum Relationship {
  SELF
  CHILD
  PARENT
  PARTNER
  OTHER
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  googleId        String?         @unique
  /// Foto de la cuenta de Google (solo para ofrecer copiarla a la ficha propia; nunca se muestra desde Google).
  googlePictureUrl String?
  createdAt       DateTime        @default(now())
  sessions        Session[]
  emailTokens     EmailToken[]
  profiles        Profile[]
  consents        ConsentRecord[]
  familyMembers   FamilyMember[]
  familyInvites   FamilyInvite[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailToken {
  id        String         @id @default(uuid())
  tokenHash String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
}

model Profile {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  relationship   Relationship
  isMinor        Boolean         @default(false)
  publicToken    String          @unique
  tokenRotatedAt DateTime        @default(now())
  /// Huella de lo último impreso (sha256 del token + datos impresos), para avisar cuándo reimprimir.
  printedHash    String?
  printedAt      DateTime?
  /// Foto de la ficha: webp 320x320 sin metadatos, cifrada como los datos médicos.
  photoCipher    String?
  photoUpdatedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  consents       ConsentRecord[]
  medicalRecord  MedicalRecord?
  alerts         EmergencyAlert[]

  @@index([ownerId])
}

model ConsentRecord {
  id               String   @id @default(uuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version          String
  guardianDeclared Boolean  @default(false)
  acceptedAt       DateTime @default(now())
}

/// Ficha médica cifrada (AES-256-GCM). La visibilidad por sección queda en claro: no es dato de salud.
model MedicalRecord {
  profileId  String   @id
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ciphertext String
  visibility Json
  updatedAt  DateTime @updatedAt
}

enum FamilyRole {
  ADMIN
  MEMBER
}

/// Grupo familiar: cuentas conectadas para recibir avisos. No da acceso a datos médicos.
model FamilyGroup {
  id              String         @id @default(uuid())
  name            String
  createdAt       DateTime       @default(now())
  lastTestAlertAt DateTime?
  members   FamilyMember[]
  invites   FamilyInvite[]
}

model FamilyMember {
  groupId  String
  group    FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     FamilyRole  @default(MEMBER)
  muted    Boolean     @default(false)
  joinedAt DateTime    @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model FamilyInvite {
  id          String      @id @default(uuid())
  groupId     String
  group       FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tokenHash   String      @unique
  invitedById String
  invitedBy   User        @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
}

model EmergencyAlert {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lat        Float?
  lng        Float?
  notified       Int      @default(0)
  familyNotified Int      @default(0)
  suppressed     Boolean  @default(false)
  test       Boolean  @default(false)

  @@index([profileId, createdAt])
}
